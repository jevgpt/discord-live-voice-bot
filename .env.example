# Copy this file to .env:  cp .env.example .env
# (npm start refuses to boot without a .env file.)
#
# Commented-out lines show the default value. Never commit your real .env --
# it is git-ignored on purpose.
#
# On/off settings take 1/0, true/false, yes/no, on/off, enabled/disabled, evet/hayır or açık/kapalı,
# whatever BOT_LANGUAGE is. A value the bot cannot read as written (an unknown on/off word or mode, a
# number outside its range, an ID that is not a 17-20 digit Discord ID) keeps its default or is moved
# into range, and is listed once when the bot starts.

# --- Discord (bot account) ---
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# The server and the voice channel the bot lives in.
# Discord -> User Settings -> Advanced -> Developer Mode, then right-click -> Copy ID
GUILD_ID=
CHANNEL_ID=
# More servers, on top of the pair above: a comma-separated list of guildId:channelId pairs.
# The bot sits in one voice channel per server, each with its own conversation, model session,
# audio path and music. The pair above stays the primary target; entries that are not a
# "guild:channel" pair, or that name a server already listed with another channel, are skipped and
# reported at start.
# VOICE_TARGETS=222222222222222222:333333333333333333,444444444444444444:555555555555555555
# How many servers may hold an OPEN GPT-Live session at the same time (minimum 1). The bill grows
# linearly with this number: beyond the cap a server stays silent (music and tools still work) and
# only starts talking once another server's session closes.
# MAX_LIVE_SESSIONS=2

# --- OpenAI (GPT-Live realtime voice) ---
# https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=
# Only if you talk to a different endpoint (proxy, gateway):
# OPENAI_BASE_URL=

# --- Language ---
# Language of everything a human sees: console logs, spoken replies, the admin panel,
# slash command descriptions and the assistant's default instructions. Voice commands
# are matched in this language as well. Supported: en, tr ("tr-TR" and the like pick the same);
# anything else runs in English and is reported at start. Local speech follows it (LOCAL_TTS_LANG).
# BOT_LANGUAGE=en

# --- Authorisation ---
# The bot owner. Their voice is processed with priority and the voice admin tools
# (ban / kick / roles / channels / permissions / settings) accept commands ONLY from them.
# Leave it empty to disable the voice admin tools entirely; there is NO default owner.
# OWNER_ID=
# Extra administrators for slash commands and the panel (comma-separated user/role ids).
# Members with the "Manage Server" permission are already allowed.
# ADMIN_USER_IDS=
# ADMIN_ROLE_IDS=
# Process only the owner's voice while they are speaking.
# OWNER_PRIORITY=1
# One voice at a time: while somebody holds the floor only their audio is sent to the model; the floor
# passes at their pause to whoever has been waiting longest, a monologue over 8 s can be taken by somebody
# talking over it for 1.5 s, and the owner always takes it at once. 0 = send everybody summed, as before.
# FLOOR_CONTROL=1

# Per-speaker loudness: a quiet microphone is raised (up to +18 dB) and a loud one lowered (down to -6 dB)
# so that the model and its transcriber hear everybody at about the same level. 0 = send levels as they are.
# AGC=1

# A talk-spurt is sent from its second frame (the first waits one tick for it), so a packet late by up to a
# frame is not a hole at the start of a word. 1 = send the first frame at once, no margin.
# PRIME_FRAMES=2

# --- Model and voice ---
# LIVE_MODEL=gpt-live-1
# LIVE_VOICE=marin
# System instructions used when no character is selected
# LIVE_INSTRUCTIONS=
# First sentence the bot says after joining (leave empty to join silently)
# GREET_TEXT=

# Tool backend (Responses API + web_search): set a model here and ALL Discord/music/memory
# tools become available to the assistant. Leave it empty and only the built-in voice
# commands work. (DELEGATION_MODEL is accepted as the old name.)
# RESEARCH_MODEL=
# auto = use the Responses backend when RESEARCH_MODEL is set; "client" forces it off
# TOOLS_BACKEND=auto
# Reasoning effort for the backend; "off" omits the field
# LIVE_BACKEND_EFFORT=low
# LIVE_BACKEND_TIER=

# Model used for written replies (DMs and mentions); images are always handled by this one
# TEXT_MODEL=
# Drawing requests ("draw me X") go to the images API of this model; the size is passed through as given
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024
# DeepSeek: if a key is set, written replies and client-side research go to DeepSeek instead.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Behaviour ---
# Listen to this user only
# SOLO_USER_ID=
# Channel used when no channel name is spoken; JOIN_NOTICE is posted here
# TEXT_CHANNEL_ID=
# How many messages a single read returns, 1-10
# READ_LIMIT=5
# RESPOND_DMS=1
# RESPOND_MENTIONS=1
# Say written channel replies out loud in the voice channel as well
# VOICE_ECHO_TEXT_REPLIES=0
# Tell the assistant who is speaking (name, whether they are the owner, stored notes).
# With 0 the assistant cannot tell people apart.
# ANNOUNCE_SPEAKER=1
# LEAVE_DELAY_MS=2500
# Print transcripts to the console
# TRANSCRIPTS=1
# Close the session after this many idle minutes; 0 = never close
# IDLE_CLOSE_MINUTES=10
# Verbose log: for every transcript fragment, which audio it was judged on, who the audio puts
# there and how sure that is; and for every finished line, who it was given to.
# DEBUG=0
# The realtime protocol's own events as well. Separate, because it is several lines a second.
# DEBUG_LIVE=0
# Local mode only: how long the ear waits after the last packet before deciding somebody has stopped
# talking. Lower answers sooner and cuts people off more often; 200-3000.
# LOCAL_STT_SILENCE_MS=700

# --- Cost control ---
# Daily GPT-Live budget in seconds (0 = unlimited). When it runs out the session stays
# closed until the next day; the owner gets a DM at 90%.
# DAILY_LIVE_SECONDS=0
# Rate limit for DMs the bot sends on its own
# DM_PER_MINUTE=10
# DM_PER_TARGET_PER_MINUTE=3

# --- Privacy ---
# Write voice transcripts and message text to the panel log (data/activity.jsonl)?
# 0 = only counted, never stored. Can also be changed at runtime.
# RECORD_TRANSCRIPTS=1
# Post a short notice in TEXT_CHANNEL_ID when the bot joins a voice channel
# JOIN_NOTICE=0

# --- Memory (per-person notes, data/memory.json) ---
# MEMORY=1

# --- Music (the bot plays its own audio: yt-dlp + ffmpeg; ducked while it speaks) ---
# MUSIC=1
# percent
# MUSIC_VOLUME=35
# volume while the bot is speaking
# MUSIC_DUCK_VOLUME=12
# how long after the bot stops speaking the volume returns
# MUSIC_DUCK_HOLD_MS=700
# local music folder; "play X" searches here first
# MUSIC_DIR=
# longer tracks are rejected; 0 = no limit
# MUSIC_MAX_MINUTES=20
# empty = look on PATH, then download into tools/bin automatically
# YTDLP_PATH=
# Fetching yt-dlp from GitHub and running it is a supply-chain decision. Set this to 0 to install it
# yourself instead; the bot then says so rather than downloading anything.
# YTDLP_AUTO_DOWNLOAD=1
# The yt-dlp release that download takes: a tag such as 2025.09.05, or latest. Either way the file is
# checked against the SHA2-256SUMS published in that release before it is used.
# YTDLP_VERSION=latest
# empty = the bundled ffmpeg-static binary
# FFMPEG_PATH=
# Show the playing track under the bot's name; the status line comes back when the music stops
# PRESENCE_MUSIC=1

# --- Other bots ---
# Bots this bot is allowed to send commands to; names or ids, comma-separated
# ALLOWED_BOTS=
# BOT_PREFIX=!
# BOT_COMMAND_CHANNEL=

# --- Gateway intents (auto = detect from the Developer Portal flags; force with 1/0) ---
# IMPORTANT: reading other people's message content requires MESSAGE_CONTENT in the portal.
# MESSAGE_CONTENT=auto
# GUILD_MEMBERS=auto
# PRESENCE=auto

# --- Local admin panel (loopback by default): http://127.0.0.1:8787  (also /healthz and /metrics) ---
# PANEL=1
# PANEL_PORT=8787
# The address the panel listens on. Anything but loopback (0.0.0.0 in a container, a LAN address) is
# refused unless PANEL_TOKEN is set as well.
# PANEL_HOST=127.0.0.1
# At least 16 characters. When set, every request needs "Authorization: Bearer <token>", or the browser
# visits /login?token=<token> once and gets a cookie (HttpOnly, SameSite=Strict, 30 days).
# PANEL_TOKEN=
# More names the panel may be reached by, for the Host-header check: the name a reverse proxy forwards,
# or localhost:9000 for a container port published as 9000. An entry with a port matches only that
# port. A name that is not loopback needs PANEL_TOKEN.
# PANEL_ALLOWED_HOSTS=

# --- Local speech (Chatterbox): install with tools/setup-chatterbox.ps1, run tools/run-chatterbox.cmd ---
# Enable the feature; while off, switching to local voice mode does nothing
# LOCAL_TTS=0
# Start in local voice mode
# LOCAL_TTS_START=0
# LOCAL_TTS_URL=http://127.0.0.1:8020
# Sent as X-Chatterbox-Token on every request to that server. Leave it empty when the bot starts the server
# itself: each start gets a fresh random token. For a server started by hand, set the same value here and
# as CHATTERBOX_TOKEN in the shell that starts it.
# LOCAL_TTS_TOKEN=
# ~10 s reference recording for voice cloning
# LOCAL_TTS_VOICE=
# tr/en/de/fr/es/it/pt/ru, or "auto" to detect from the text; empty = the bot's language (BOT_LANGUAGE)
# LOCAL_TTS_LANG=

# Let the bot start the Chatterbox server itself when it needs it (uses .venv-chatterbox)
# LOCAL_TTS_AUTOSTART=1
# empty = the python inside .venv-chatterbox
# LOCAL_TTS_PYTHON=
# multilingual/turbo/nano/english
# LOCAL_TTS_MODEL=multilingual
# tiny/base/small/medium/large-v3
# LOCAL_STT_MODEL=small

# --- Jev (TypeSafe System One): typed judgments about each finished line ---
# With a key, every finished line is judged "was this said to the bot?" and "a request, a question,
# banter, or people talking among themselves?", and the model is told when a line was a joke or was
# not for it. Keys from https://typesafe.ai; the value is never logged.
# JEV_API_KEY=
# JEV=1
# JEV_MODEL=jev-latest
# 1 = a reply to a line that was not for the bot is kept off the channel (the line is judged as soon as it
# settles and the reply held for up to 2 s while Jev answers); 0 = Jev only advises the model
# JEV_REPLY_GATE=1
# Jev requests per session before it goes quiet (0 = no cap)
# JEV_MAX_CALLS=3000

# --- Self-diagnosis ---
# The session reports on itself every five minutes and when it closes: drift, how many fragments the audio
# could place, lines nobody owned, gate refusals and why, Jev verdicts and latency, slow tools.
# The flight recorder: who the mixer heard on each frame, where the transcript put each fragment, every
# decision, to data/traces/<time>.jsonl (no audio; words only when RECORD_TRANSCRIPTS allows). Replay one
# with: node scripts/replay-trace.mjs data/traces/<file>.jsonl
# TRACE=0
# Exactly the audio sent to the model, as data/traces/sent-<time>.wav (24 kHz mono, 2.9 MB a minute): the
# answer to "what did it hear" when a transcript comes back wrong.
# TRACE_AUDIO=0

# --- Local brain: voice chat without OpenAI (ears = whisper, brain = DeepSeek/OpenAI chat, mouth = Chatterbox) ---
# Needs the Chatterbox server started with --stt (run-chatterbox.cmd does this) and a text model.
# auto = fall back to the local brain when GPT-Live hits a credit/key error and return when it
# recovers; local = always local; live = never fall back
# BRAIN_MODE=auto
# empty = LOCAL_TTS_URL
# LOCAL_STT_URL=
# auto (or empty) = detect the language of every line; a code such as tr or en fixes it
# LOCAL_STT_LANG=auto
# auto: name/single speaker/ongoing conversation/question; addressed: only when named; always
# LOCAL_BRAIN_RESPOND=auto
